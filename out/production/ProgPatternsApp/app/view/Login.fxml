<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="345.0" prefWidth="588.0" style="-fx-background-color: #7A6B9D;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controller.LoginController">
   <Label layoutX="187.0" layoutY="113.0" prefHeight="17.0" prefWidth="68.0" text="Username: " textFill="#ede7f6" />
   <TextField fx:id="username" layoutX="253.0" layoutY="108.0" />
   <Label layoutX="187.0" layoutY="146.0" prefHeight="17.0" prefWidth="80.0" text="Password: " textFill="#ede7f6" />
   <PasswordField fx:id="password" layoutX="253.0" layoutY="142.0" />
   <Button fx:id="enter" layoutX="274.0" layoutY="184.0" mnemonicParsing="false" onAction="#loginFunction" text="Enter" textAlignment="CENTER" />
   <Label layoutX="238.0" layoutY="35.0" prefHeight="50.0" prefWidth="117.0" text="LOGIN" textFill="#ede7f6">
      <font>
         <Font name="Georgia" size="35.0" />
      </font>
   </Label>
   <Label fx:id="signInText" layoutX="234.0" layoutY="220.0" onMouseClicked="#signInPane" text="Don't have an account?" textFill="#2c2a3e">
      <cursor>
         <Cursor fx:constant="OPEN_HAND" />
      </cursor>
   </Label>
   <Pane fx:id="signInPane" layoutX="3.0" layoutY="7.0" prefHeight="338.0" prefWidth="588.0" style="-fx-background-color: #7A6B9D;" visible="false">
      <children>
         <Label layoutX="148.0" layoutY="36.0" prefHeight="39.0" prefWidth="306.0" text="CREATE ACCOUNT" textFill="#ede7f6">
            <font>
               <Font name="Arial" size="32.0" />
            </font>
         </Label>
         <TextField fx:id="fName" layoutX="113.0" layoutY="104.0" prefHeight="25.0" prefWidth="177.0" promptText="First Name" />
         <TextField fx:id="lName" layoutX="301.0" layoutY="104.0" prefHeight="25.0" prefWidth="134.0" promptText="Last Name" />
         <TextField fx:id="age" layoutX="445.0" layoutY="104.0" prefHeight="25.0" prefWidth="44.0" promptText="Age" />
         <TextField fx:id="sUsername" layoutX="301.0" layoutY="139.0" prefHeight="25.0" prefWidth="189.0" promptText="Username" />
         <Button fx:id="signIn" layoutX="270.0" layoutY="228.0" mnemonicParsing="false" onAction="#signInFunction" text="Enter" />
         <TextField fx:id="email" layoutX="113.0" layoutY="139.0" prefHeight="25.0" prefWidth="177.0" promptText="Email" />
         <PasswordField fx:id="sPassword" layoutX="113.0" layoutY="174.0" prefHeight="25.0" prefWidth="177.0" promptText="Password" />
         <Label fx:id="back" layoutX="14.0" layoutY="6.0" onMouseClicked="#goBackLogin" text="&lt; Go back " textFill="#2c2a3e">
            <cursor>
               <Cursor fx:constant="OPEN_HAND" />
            </cursor>
         </Label>
         <PasswordField fx:id="cPass" layoutX="301.0" layoutY="174.0" prefHeight="25.0" prefWidth="189.0" promptText="Confirm Password" />
      </children>
   </Pane>
</AnchorPane>
