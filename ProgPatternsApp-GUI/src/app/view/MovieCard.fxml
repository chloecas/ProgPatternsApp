<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="255.0" prefWidth="172.0" spacing="8" style="-fx-padding: 10; -fx-background-color: #EDE7F6; -fx-background-radius: 10; -fx-border-color: #2C2A3E;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controller.MovieCardController">

    <ImageView fx:id="poster" fitHeight="160.0" fitWidth="147.0" style="visibility: true;" />
    <Label fx:id="titleLabel" alignment="CENTER" contentDisplay="CENTER" prefHeight="20.0" prefWidth="165.0" style="-fx-font-weight: bold; -fx-text-alignment: center;" text="Title" textAlignment="CENTER">
      <font>
         <Font size="14.0" />
      </font></Label>
    <Label fx:id="ratingLabel" alignment="BOTTOM_CENTER" contentDisplay="CENTER" prefHeight="24.0" prefWidth="155.0" text="Rating" textAlignment="CENTER">
      <font>
         <Font name="Georgia" size="12.0" />
      </font></Label>
</VBox>
