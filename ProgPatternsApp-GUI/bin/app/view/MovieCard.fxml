<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="app.controller.MovieCardController"
      spacing="8"
      style="-fx-padding:10; -fx-background-color:#2b2b2b; -fx-background-radius:10;">

    <ImageView fx:id="poster" fitWidth="150" fitHeight="220"/>
    <Label fx:id="titleLabel" style="-fx-font-weight:bold;"/>
    <Label fx:id="ratingLabel"/>
</VBox>
