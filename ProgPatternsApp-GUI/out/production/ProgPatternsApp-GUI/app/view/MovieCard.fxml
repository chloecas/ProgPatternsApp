    <Label fx:id="titleLabel" alignment="CENTER" contentDisplay="CENTER" prefHeight="20.0" prefWidth="283.0" style="-fx-font-weight: bold; -fx-text-alignment: center;" text="Title" textAlignment="CENTER">
      <font>
         <Font size="14.0" />
      </font></Label>
    <Label fx:id="ratingLabel" alignment="BOTTOM_CENTER" contentDisplay="CENTER" prefHeight="24.0" prefWidth="280.0" text="Rating" textAlignment="CENTER">
