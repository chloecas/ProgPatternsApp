<VBox prefHeight="406.0" prefWidth="320.0" spacing="8" style="-fx-padding: 10; -fx-background-color: pink; -fx-background-radius: 10; -fx-border-color: red;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controller.MovieCardController">

